---
import Base from '../layouts/Base.astro';
import CountryGrid from '../components/CountryGrid.astro';
import ProviderTable from '../components/ProviderTable.astro';
import data from '../data/providers.json';
import { CHECKED_ON, u } from '../site.js';
import { allCountries, publishedPages } from '../lib/countries.js';
const countryList = allCountries();
const guides = publishedPages().filter((g) => !/^country\//.test(g.path)).sort((a, b) => a.title.localeCompare(b.title));
const sourceCount = new Set(data.providers.flatMap((p) => [p.merchantOfRecord.source, ...p.facts.map((f) => f.source), ...Object.values(p.sellerCountries || {}).map((s) => s.source)])).size;
---
<Base title="Get Paid From Anywhere: Stripe alternatives by country" description="Which payment providers and merchants of record accept founders from your country. Sourced country rules and fees for Stripe, Paddle, Lemon Squeezy, Polar, Dodo Payments and more.">
  <section class="hero">
    <h1>Stripe not available where you live?</h1>
    <p class="lede">See which payment providers say they accept sellers from your country, what they charge, and the US company route. Every fact links to the provider's own page and shows the date we checked it.</p>
    <form class="picker" action={u('/countries/')} method="get" data-picker>
      <label for="country-pick"><strong>Where are you based?</strong></label>
      <div class="picker-row">
        <select id="country-pick" name="c" required>
          <option value="">Choose your country</option>
          {countryList.map((c) => <option value={u(`/country/${c.slug}/`)}>{c.name}</option>)}
        </select>
        <button class="btn" type="submit">Show my options</button>
      </div>
    </form>
    <ul class="facts">
      <li><strong>{data.providers.length}</strong> providers tracked</li>
      <li><strong>{countryList.length}</strong> country guides</li>
      <li><strong>{sourceCount}</strong> source pages cited</li>
      <li>Checked <strong>{CHECKED_ON}</strong></li>
    </ul>
  </section>

  <h2 id="countries">Pick your country</h2>
  <CountryGrid />
  <p><small>More countries are added as we finish checking them. See <a href={u('/countries/')}>all countries</a>.</small></p>

  <h2 id="compare">Compare providers</h2>
  <p class="prose">Filter by type, sort by any column, or pick a country to see each provider's status there.</p>
  <ProviderTable />

  {guides.length > 0 && (<>
    <h2>Guides</h2>
    <ul class="cards">{guides.map((g) => <li><a class="card" href={u(`/${g.path}/`)}><strong>{g.h1 || g.title}</strong><span class="sub">Checked {g.checkedOn}</span></a></li>)}</ul>
  </>)}

  <h2>How we check facts</h2>
  <div class="how">
    <div><h3>Provider pages only</h3><p>Every fact comes from the provider's own help center, docs, pricing or legal pages. No forums, reviews or third-party blogs.</p></div>
    <div><h3>Linked and dated</h3><p>Each fact shows its source link and the date we checked it. If we could not confirm something, we say "unknown".</p></div>
    <div><h3>Not for sale</h3><p>We do not rank providers by payout and do not accept payment to change a status. See the <a href={u('/affiliate-disclosure/')}>affiliate disclosure</a>.</p></div>
  </div>
  <p><a href={u('/methodology/')}>Read the full methodology</a> · <a href={u('/data/providers.json')}>Download the dataset</a></p>
</Base>
<style>
.hero { padding:28px 0 8px; }
.hero h1 { margin-top:10px; max-width:820px; }
.picker { margin:22px 0 10px; background:var(--soft); border:1px solid var(--line); border-radius:14px; padding:18px; max-width:640px; }
.picker label { display:block; margin-bottom:8px; font-size:18px; }
.picker-row { display:flex; gap:10px; flex-wrap:wrap; }
.picker-row select { flex:1 1 240px; }
.facts { list-style:none; padding:0; margin:14px 0 0; display:flex; flex-wrap:wrap; gap:8px 22px; font-size:15px; color:var(--muted); }
.facts strong { color:var(--fg); }
.how { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; }
.how > div { border:1px solid var(--line); border-radius:var(--radius); padding:4px 16px 8px; }
.how h3 { margin-top:12px; font-size:17px; }
.how p { font-size:15px; margin-top:4px; }
</style>
<script is:inline>
document.querySelectorAll('[data-picker]').forEach(function (f) {
  var s = f.querySelector('select');
  f.addEventListener('submit', function (e) { e.preventDefault(); if (s.value) location.href = s.value; });
  s.addEventListener('change', function () { if (s.value) location.href = s.value; });
});
</script>
