---
import Base from '../layouts/Base.astro';
import CountryAnswers from '../components/CountryAnswers.astro';
import { CHECKED_ON, PICK_RULE, SITE_LINE, SITE_SUBLINE, affiliateProviders, fmtDate, u } from '../site.js';
import { allCountries, publishedPages } from '../lib/countries.js';
const countryList = allCountries();
const guides = publishedPages().filter((g) => !/^country\//.test(g.path)).sort((a, b) => a.title.localeCompare(b.title));
const hasAffiliate = affiliateProviders().length > 0;
const kinds = [
  { t: 'Merchant of record', d: 'Sells your product to the customer for you, collects sales tax and VAT, then pays you. You do not need a US company. This is usually the easiest start when Stripe is closed to you.', ex: [['Paddle', 'paddle'], ['Polar', 'polar'], ['Dodo Payments', 'dodo-payments'], ['Lemon Squeezy', 'lemon-squeezy']] },
  { t: 'Payment processor', d: 'Takes card payments for your own business. Lower fees, but you register for and pay sales tax and VAT yourself.', ex: [['Stripe', 'stripe'], ['Paystack', 'paystack']] },
  { t: 'Payout account', d: 'Receives money from platforms and clients abroad and sends it to your local bank.', ex: [['Wise', 'wise-business'], ['Payoneer', 'payoneer'], ['Airwallex', 'airwallex']] },
  { t: 'US company', d: 'You form a US LLC so you can apply to Stripe and US banks as a US business. It costs money every year and adds paperwork.', ex: [['Stripe Atlas', 'stripe-atlas'], ['doola', 'doola']] },
];
---
<Base title="Get Paid From Anywhere: Stripe alternatives by country" description="Which payment provider should you use in your country? One pick per country, what it costs and why, with every fact linked to the provider's own page. For founders outside the US.">
  <section class="hero">
    <h1>{SITE_LINE}</h1>
    <p class="lede">{SITE_SUBLINE}</p>
    <form class="picker" action={u('/countries/')} method="get" data-picker>
      <label for="country-pick">Where do you live?</label>
      <div class="picker-row">
        <select id="country-pick" name="c" required>
          <option value="">Choose your country</option>
          {countryList.map((c) => <option value={u(`/country/${c.slug}/`)}>{c.name}</option>)}
        </select>
        <button class="btn" type="submit">Show my answer</button>
      </div>
    </form>
  </section>

  <section>
    <div class="sec-head"><h2 id="countries">The answer for each country</h2><p>Checked {fmtDate(CHECKED_ON)}</p></div>
    <CountryAnswers />
  </section>

  <section>
    <h2 id="kinds">Four kinds of provider, in plain English</h2>
    <dl class="kinds">
      {kinds.map((k) => (
        <div><dt>{k.t}</dt><dd>{k.d}</dd><dd class="ex">For example {k.ex.map(([n, s], i) => <>{i > 0 && (i === k.ex.length - 1 ? ' and ' : ', ')}<a href={u(`/provider/${s}/`)}>{n}</a></>)}.</dd></div>
      ))}
    </dl>
  </section>

  <section class="how">
    <h2 id="how">How we pick</h2>
    <div>
      <ol>{PICK_RULE.map((r) => <li>{r}</li>)}</ol>
      <p>Every fact comes from the provider's own pages, with a link and the date we checked it. {hasAffiliate ? 'Some links are affiliate links, and they are marked.' : 'No links on this site are affiliate links today.'} <a href={u('/methodology/')}>The full method</a>, <a href={u('/affiliate-disclosure/')}>the disclosure</a> and <a href={u('/data/providers.json')}>the dataset</a>.</p>
    </div>
  </section>

  {guides.length > 0 && (<section>
    <h2 id="guides">Guides</h2>
    <ul class="glist">{guides.map((g) => <li><a href={u(`/${g.path}/`)}>{g.h1 || g.title}</a> <span>{g.description}</span></li>)}</ul>
    <p><a href={u('/guides/')}>All guides</a></p>
  </section>)}
</Base>
<style>
.hero { padding:48px 0 32px; max-width:940px; }
@media (max-width:760px) { .hero { padding:28px 0 24px; } }
.hero h1 { margin:0 0 16px; font-size:clamp(36px, 5.4vw, 60px); }
.hero .lede { margin:0; max-width:640px; }
.picker { margin:28px 0 0; max-width:600px; }
.picker label { display:block; margin-bottom:8px; font-size:15px; font-weight:600; color:var(--ink); }
.picker-row { display:flex; gap:10px; flex-wrap:wrap; }
.picker-row select { flex:1 1 260px; }
@media (max-width:480px) { .picker-row .btn { flex:1 1 100%; } }
.sec-head { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:4px 20px; margin:40px 0 12px; }
.sec-head h2 { margin:0; }
.sec-head p { margin:0; color:var(--muted); font-size:14.5px; }
.kinds { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 48px; margin:16px 0 0; }
@media (max-width:760px) { .kinds { grid-template-columns:1fr; } }
.kinds div { border-top:1px solid var(--ink); padding:14px 0 18px; }
.kinds dt { font-family:var(--serif); font-size:21px; font-weight:650; color:var(--ink); }
.kinds dd { margin:6px 0 0; }
.kinds .ex { font-size:15px; color:var(--muted); }
.how { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,2fr); gap:8px 48px; margin-top:56px; padding-top:8px; border-top:3px solid var(--ink); }
@media (max-width:760px) { .how { grid-template-columns:1fr; } }
.how h2 { margin:16px 0 0; }
.how ol { margin:18px 0 12px; padding-left:22px; }
.how li { margin:0 0 8px; }
.how p { color:var(--muted); font-size:15.5px; margin:0; }
.glist { list-style:none; padding:0; margin:12px 0; border-top:1px solid var(--line); max-width:860px; }
.glist li { padding:12px 0; border-bottom:1px solid var(--line); }
.glist a { font-weight:600; font-size:17px; }
.glist span { display:block; font-size:15px; color:var(--muted); margin-top:2px; }
</style>
<script is:inline>
document.querySelectorAll('[data-picker]').forEach(function (f) {
  var s = f.querySelector('select');
  f.addEventListener('submit', function (e) { e.preventDefault(); if (s.value) location.href = s.value; });
  s.addEventListener('change', function () { if (s.value) location.href = s.value; });
});
</script>
