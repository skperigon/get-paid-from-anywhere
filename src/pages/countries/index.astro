---
import Base from '../../layouts/Base.astro';
import CountryAnswers from '../../components/CountryAnswers.astro';
import Status from '../../components/Status.astro';
import data from '../../data/providers.json';
import countries from '../../data/countries.json';
import { CHECKED_ON, u } from '../../site.js';
import Byline from '../../components/Byline.astro';
const mors = data.providers.filter((p) => p.category === 'Merchant of record' || p.slug === 'stripe');
---
<Base title="Stripe alternatives by country: all country guides" description={`Country guides for founders where Stripe is limited or missing. Which merchants of record and payment providers accept sellers from each country, with sources. Checked ${CHECKED_ON}.`} crumb="Countries">
  <h1>Pick your country</h1>
  <Byline date={CHECKED_ON} />
  <p class="lede">Choose where you live or where your company is registered. Each page names one provider to start with, then covers Stripe, the US company route and banking, with a source for every fact.</p>
  <CountryAnswers />

  <h2>Can you sign up? Every country side by side</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Provider</th>{countries.map((c) => <th><a href={u(`/country/${c.slug}/`)}>{c.name}</a></th>)}</tr></thead>
    <tbody>
      {mors.map((p) => (<tr><td><a href={u(`/provider/${p.slug}/`)}>{p.name}</a></td>{countries.map((c) => <td><Status status={p.sellerCountries[c.slug] ? p.sellerCountries[c.slug].status : 'unknown'} /></td>)}</tr>))}
    </tbody>
  </table></div>
  <p><small>Open a country page for the notes and source links behind each label. What each answer means is on <a href={u('/methodology/')}>How we pick</a>.</small></p>
</Base>
