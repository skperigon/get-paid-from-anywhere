---
import Base from '../../layouts/Base.astro';
import ProviderTable from '../../components/ProviderTable.astro';
import Byline from '../../components/Byline.astro';
import data from '../../data/providers.json';
import { CHECKED_ON, GROUPS, fmtDate, headlineFee, plainType, u } from '../../site.js';
---
<Base title="Payment providers for founders outside the US and EU" description={`Compare ${data.providers.length} merchants of record, payment processors, business accounts and US formation services, with sourced fees and country rules. Checked ${CHECKED_ON}.`} crumb="Providers">
  <div class="prose">
    <h1>Payment providers</h1>
    <Byline date={CHECKED_ON} />
    <p class="lede">Every provider we track, grouped by what it does for you. If you are not sure where to start, <a href={u('/countries/')}>pick your country</a> instead.</p>
  </div>
  {GROUPS.map((g) => {
    const list = data.providers.filter(g.match);
    return list.length > 0 && (
      <section class="grp">
        <h2 id={g.key}>{g.title}</h2>
        <ul class="plist">{list.map((p) => { const f = headlineFee(p); return (
          <li><a href={u(`/provider/${p.slug}/`)}>{p.name}</a><span class="pl-s">{p.summary}</span><span class="pl-f">{f || ''}</span></li>
        ); })}</ul>
      </section>
    );
  })}
  <h2 id="table">Every provider in one table</h2>
  <ProviderTable />
  <p><small>The full dataset, with every source link and checked date, is available as <a href={u('/data/providers.json')}>JSON</a>. Data last checked {fmtDate(CHECKED_ON)}.</small></p>
</Base>
<style>
.plist { list-style:none; margin:0; padding:0; border-top:1px solid var(--ink); }
.plist li { display:grid; grid-template-columns:minmax(140px,1fr) minmax(0,3fr) minmax(120px,1fr); gap:6px 24px; padding:12px 0; border-bottom:1px solid var(--line); align-items:baseline; }
.plist a { font-family:var(--serif); font-size:19px; font-weight:650; color:var(--ink); }
.pl-s { font-size:15px; }
.pl-f { font-size:14.5px; color:var(--muted); text-align:right; }
@media (max-width:700px) { .plist li { grid-template-columns:1fr; } .pl-f { text-align:left; } }
</style>
