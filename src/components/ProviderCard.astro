---
// Comparison card for one provider. Every number comes from providers.json.
import { score, prosCons, headlineFee, pickFor, openCountries, TRACKED_COUNT, isAffiliate, outHref, outRel, host, providerChecked, fmtDate, u } from '../site.js';
const { p, compare = false, rank } = Astro.props;
const sc = score(p);
const pc = prosCons(p);
const pick = pickFor(p.slug);
const payout = p.facts.find((f) => /payout schedule/i.test(f.label));
const formation = p.category === 'US company formation';
const aff = isAffiliate(p);
---
<article class="pcard" data-slug={p.slug}>
  {pick && <div class="pick"><span>Best for</span>{pick.label}</div>}
  <div class="pc-top">
    <div class="pc-id">
      <h3><a href={u(`/provider/${p.slug}/`)}>{p.name}</a></h3>
      <span class="pc-type">{p.category}</span>
    </div>
    {sc && <a class="pc-score" href={u('/methodology/#score')} title="Checklist score. See how we rate.">
      <span class="n">{sc.total}<small>/{sc.max}</small></span><span class="l">Checklist</span>
    </a>}
  </div>
  <dl class="pc-keys">
    <div><dt>{formation ? 'Price' : 'Headline fee'}</dt><dd>{headlineFee(p)}</dd></div>
    {!formation && <div><dt>Merchant of record</dt><dd>{p.merchantOfRecord.value}</dd></div>}
    {!formation && sc && <div><dt>Countries open</dt><dd>{openCountries(p).length} of {TRACKED_COUNT} tracked</dd></div>}
    {payout && <div><dt>Payouts</dt><dd>{payout.value}</dd></div>}
  </dl>
  {pick && <p class="pc-why">{pick.why}</p>}
  <div class="pc-pc">
    {pc.pros.length > 0 && <ul class="pros" aria-label="Pros">{pc.pros.map((x) => <li>{x}</li>)}</ul>}
    {pc.cons.length > 0 && <ul class="cons" aria-label="Cons">{pc.cons.map((x) => <li>{x}</li>)}</ul>}
  </div>
  <div class="pc-foot">
    <a class="btn" href={outHref(p)} rel={outRel(p)} target="_blank" title={host(outHref(p))}>Visit site</a>
    <a class="btn btn-ghost" href={u(`/provider/${p.slug}/`)}>Details</a>
    {compare && <label class="pc-cmp"><input type="checkbox" data-compare={p.slug} data-name={p.name} /> Compare</label>}
  </div>
  <p class="pc-disc">{aff ? <>Affiliate link: we may earn a commission. <a href={u('/affiliate-disclosure/')}>Disclosure</a></> : <>Not an affiliate link. <a href={u('/affiliate-disclosure/')}>Disclosure</a></>} · Checked {fmtDate(providerChecked(p))}</p>
</article>
<style>
.pcard { position:relative; border:1px solid var(--line); border-radius:16px; background:#fff; padding:20px 22px 14px; box-shadow:var(--shadow); display:flex; flex-direction:column; gap:12px; }
.pick { align-self:flex-start; margin:-20px 0 0 -22px; border-radius:16px 0 12px 0; background:var(--ink); color:#fff; font-size:12.5px; font-weight:650; padding:6px 14px; letter-spacing:.01em; }
.pick span { color:#34d399; text-transform:uppercase; font-size:11px; letter-spacing:.08em; margin-right:4px; }
.pc-top { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }
.pc-id h3 { margin:0; font-size:21px; letter-spacing:-.02em; }
.pc-id h3 a { color:var(--ink); text-decoration:none; }
.pc-id h3 a:hover { text-decoration:underline; }
.pc-type { font-size:13.5px; color:var(--muted); }
.pc-score { flex:none; text-decoration:none; text-align:center; border:1px solid var(--line); border-radius:12px; padding:6px 12px; background:var(--accent-soft); }
.pc-score .n { display:block; font-size:24px; font-weight:780; color:var(--ok-fg); line-height:1.1; letter-spacing:-.02em; }
.pc-score .n small { font-size:13px; color:var(--muted); font-weight:600; }
.pc-score .l { display:block; font-size:11px; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); font-weight:650; }
.pc-keys { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0; margin:0; border:1px solid var(--line); border-radius:12px; overflow:hidden; }
.pc-keys > div { padding:10px 12px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); margin:0 -1px -1px 0; }
.pc-keys dt { font-size:11.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); font-weight:650; }
.pc-keys > div:first-child:nth-last-child(odd) { grid-column:1 / -1; }
.pc-keys dd { margin:2px 0 0; font-size:14.5px; font-weight:600; color:var(--ink); line-height:1.4; }
.pc-why { margin:0; font-size:14.5px; color:#33455a; }
.pc-pc { display:grid; grid-template-columns:1fr; gap:2px; }
.pc-pc ul { list-style:none; margin:0; padding:0; font-size:14px; line-height:1.45; }
.pc-pc li { position:relative; padding-left:22px; margin:5px 0; }
.pros li::before { content:"+"; position:absolute; left:0; top:-1px; width:16px; height:16px; border-radius:50%; background:var(--ok); color:var(--ok-fg); font-weight:800; font-size:13px; line-height:16px; text-align:center; }
.cons li::before { content:"\2212"; position:absolute; left:0; top:-1px; width:16px; height:16px; border-radius:50%; background:var(--no); color:var(--no-fg); font-weight:800; font-size:13px; line-height:16px; text-align:center; }
.pc-foot { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-top:auto; padding-top:4px; }
.pc-foot .btn { padding:9px 16px; font-size:14.5px; }
.pc-foot .btn:first-child { flex:1 1 auto; }
.pc-cmp { margin-left:auto; font-size:14px; font-weight:600; color:var(--ink); display:flex; gap:6px; align-items:center; cursor:pointer; }
.pc-cmp input { width:17px; height:17px; accent-color:var(--accent); }
.pc-disc { margin:0; font-size:12.5px; color:var(--muted); }
.pc-disc a { color:var(--muted); }
</style>
