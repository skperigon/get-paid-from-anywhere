---
import { SITE_NAME, SITE_TAGLINE, CHECKED_ON, u, affiliateProviders } from '../site.js';
interface Crumb { name: string; path: string }
interface Props {
  title: string; description: string; faqs?: { q: string; a: string }[]; jsonLd?: object[];
  dateModified?: string; crumb?: string; crumbs?: Crumb[]; noindex?: boolean;
}
const { title, description, faqs = [], jsonLd = [], dateModified, crumb, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(u('/'), Astro.site).href;
const isHome = canonical === home;
const ogImage = new URL(u('/og.png'), Astro.site).href;
const schemas = [...jsonLd];
const publisher = { '@type': 'Organization', name: SITE_NAME, url: home, logo: new URL(u('/icon-512.png'), Astro.site).href };

// Breadcrumbs: Home > section (if any) > this page.
let middle: Crumb[] = Astro.props.crumbs || [];
if (!Astro.props.crumbs) {
  if (canonical.includes('/provider/')) middle = [{ name: 'Providers', path: '/providers/' }];
  else if (canonical.includes('/country/')) middle = [{ name: 'Countries', path: '/countries/' }];
}
const current = crumb || title.replace(/\s*\(checked [^)]*\)\s*$/, '');
const trail = isHome ? [] : [{ name: 'Home', href: u('/') }, ...middle.map((m) => ({ name: m.name, href: u(m.path) })), { name: current, href: null }];

if (isHome) {
  schemas.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: home, description, publisher });
} else if (!noindex) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.href ? new URL(c.href, Astro.site).href : canonical })),
  });
}
if (dateModified) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    dateModified,
    image: ogImage,
    mainEntityOfPage: canonical,
    author: publisher,
    publisher,
  });
}
if (faqs.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const path = Astro.url.pathname;
const nav = [
  { name: 'Countries', path: '/countries/' },
  { name: 'Providers', path: '/providers/' },
  { name: 'Methodology', path: '/methodology/' },
  { name: 'About', path: '/about/' },
];
const hasAffiliate = affiliateProviders().length > 0;
const year = CHECKED_ON.slice(0, 4);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="theme-color" content="#0f3d3e" />
<link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={u('/favicon-48.png')} type="image/png" sizes="48x48" />
<link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={dateModified ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_NAME}: ${SITE_TAGLINE}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{dateModified && <meta property="article:modified_time" content={dateModified} />}
<link rel="sitemap" href={u('/sitemap-index.xml')} />
{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
<style is:global>
:root {
  --fg:#16202a; --muted:#5a6672; --line:#e2e6ea; --bg:#fff; --soft:#f5f7f8;
  --brand:#0f3d3e; --accent:#0a6c74; --accent-soft:#e6f3f3; --link:#0a5f8a;
  --ok:#e3f4e8; --ok-fg:#1d6b38; --warn:#fff3d1; --warn-fg:#7a5600; --no:#fde6e6; --no-fg:#9b2424; --unk:#eef0f2; --unk-fg:#4c5660;
  --radius:10px; --wide:1080px; --narrow:760px;
}
* { box-sizing:border-box; }
html { -webkit-text-size-adjust:100%; }
body { margin:0; font:17px/1.65 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; color:var(--fg); background:var(--bg); }
a { color:var(--link); text-underline-offset:2px; }
a:hover { color:var(--accent); }
img, svg { max-width:100%; }
.skip { position:absolute; left:-999px; }
.skip:focus { left:12px; top:12px; background:#fff; padding:6px 10px; z-index:10; }

.site-header { position:sticky; top:0; z-index:5; background:rgba(255,255,255,.96); backdrop-filter:saturate(1.5) blur(6px); border-bottom:1px solid var(--line); }
.site-header .in { max-width:var(--wide); margin:0 auto; padding:10px 20px; display:flex; align-items:center; gap:20px; }
.brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--fg); font-weight:700; letter-spacing:-.01em; white-space:nowrap; }
.brand svg { width:30px; height:30px; flex:none; }
.site-nav { margin-left:auto; display:flex; gap:4px; overflow-x:auto; scrollbar-width:none; }
.site-nav a { padding:6px 12px; border-radius:8px; color:var(--fg); text-decoration:none; font-size:15px; white-space:nowrap; }
.site-nav a:hover { background:var(--soft); }
.site-nav a[aria-current="page"] { background:var(--accent-soft); color:var(--brand); font-weight:600; }
@media (max-width:720px) {
  .site-header .in { flex-wrap:wrap; gap:6px; padding:8px 14px; }
  .site-nav { margin-left:0; width:100%; }
  .site-nav a { padding:5px 10px; font-size:14px; }
}

main { max-width:var(--wide); margin:0 auto; padding:0 20px 20px; }
.prose { max-width:var(--narrow); }
.crumbs { font-size:14px; color:var(--muted); margin:18px 0 0; padding:0; list-style:none; display:flex; flex-wrap:wrap; gap:6px; }
.crumbs li:not(:last-child)::after { content:"/"; margin-left:6px; color:#b0b8c0; }
.crumbs a { color:var(--muted); }
h1 { line-height:1.2; font-size:clamp(28px, 4.5vw, 40px); letter-spacing:-.02em; margin:14px 0 10px; }
h2[id], h3[id] { scroll-margin-top:80px; }
h2 { margin-top:40px; font-size:24px; letter-spacing:-.01em; line-height:1.3; }
h3 { margin-top:28px; font-size:19px; }
.lede { font-size:19px; color:#2c3843; max-width:var(--narrow); }
.meta { display:inline-flex; flex-wrap:wrap; gap:8px; align-items:center; font-size:14px; color:var(--muted); margin:4px 0 12px; }
.meta .chip { background:var(--soft); border:1px solid var(--line); border-radius:999px; padding:2px 10px; }

.table-wrap { overflow-x:auto; border:1px solid var(--line); border-radius:var(--radius); margin:14px 0; }
table { border-collapse:collapse; width:100%; font-size:15px; }
th, td { border-bottom:1px solid var(--line); padding:10px 12px; text-align:left; vertical-align:top; }
tbody tr:last-child td { border-bottom:0; }
th { background:var(--soft); font-size:13px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); white-space:nowrap; }
tbody tr:hover { background:#fafbfc; }
article table { display:block; overflow-x:auto; border:1px solid var(--line); border-radius:var(--radius); }

.badge { display:inline-block; padding:2px 9px; border-radius:999px; font-size:13px; font-weight:600; white-space:nowrap; }
.ok { background:var(--ok); color:var(--ok-fg); } .warn { background:var(--warn); color:var(--warn-fg); } .no { background:var(--no); color:var(--no-fg); } .unk { background:var(--unk); color:var(--unk-fg); }
.note { background:var(--accent-soft); border:1px solid #cfe6e6; border-radius:var(--radius); padding:12px 16px; margin:20px 0; max-width:var(--narrow); }
.muted, small { color:var(--muted); }

.cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:14px; padding:0; margin:16px 0; list-style:none; }
.card { display:block; border:1px solid var(--line); border-radius:var(--radius); padding:14px 16px; text-decoration:none; color:var(--fg); background:#fff; transition:border-color .15s, box-shadow .15s; height:100%; }
a.card:hover { border-color:var(--accent); box-shadow:0 2px 10px rgba(15,61,62,.08); color:var(--fg); }
.card strong { display:block; font-size:17px; color:var(--brand); }
.card .sub { display:block; font-size:14px; color:var(--muted); margin-top:4px; }
.card .row { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }

.btn { display:inline-block; background:var(--brand); color:#fff; border:0; border-radius:8px; padding:9px 16px; font:inherit; font-size:15px; font-weight:600; text-decoration:none; cursor:pointer; }
.btn:hover { background:var(--accent); color:#fff; }
.btn-ghost { background:#fff; color:var(--brand); border:1px solid var(--line); }
.btn-ghost:hover { background:var(--soft); color:var(--brand); }
select, input[type=search] { font:inherit; font-size:16px; padding:8px 12px; border:1px solid #c9d0d6; border-radius:8px; background:#fff; color:var(--fg); }

.site-footer { border-top:1px solid var(--line); margin-top:56px; background:var(--soft); }
.site-footer .in { max-width:var(--wide); margin:0 auto; padding:24px 20px 34px; font-size:14px; color:var(--muted); display:grid; gap:10px; }
.site-footer nav { display:flex; flex-wrap:wrap; gap:6px 18px; }
.site-footer a { color:var(--muted); }
.site-footer p { margin:0; max-width:var(--narrow); }
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="in">
    <a class="brand" href={u('/')} aria-label={`${SITE_NAME} home`}>
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#0f3d3e"/><circle cx="32" cy="32" r="18" fill="none" stroke="#fff" stroke-width="4"/><ellipse cx="32" cy="32" rx="8" ry="18" fill="none" stroke="#fff" stroke-width="3.5"/><path d="M14 32h36" stroke="#fff" stroke-width="3.5"/><circle cx="48" cy="16" r="7" fill="#3fc1a5"/></svg>
      <span>{SITE_NAME}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((n) => <a href={u(n.path)} aria-current={path.startsWith(u(n.path)) ? 'page' : undefined}>{n.name}</a>)}
    </nav>
  </div>
</header>
<main id="main">
  {trail.length > 0 && (
    <nav aria-label="Breadcrumb"><ol class="crumbs">
      {trail.map((c) => <li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
    </ol></nav>
  )}
  <slot />
</main>
<footer class="site-footer">
  <div class="in">
    <nav aria-label="Footer">
      <a href={u('/countries/')}>Countries</a><a href={u('/providers/')}>Providers</a><a href={u('/methodology/')}>Methodology</a><a href={u('/about/')}>About</a><a href={u('/affiliate-disclosure/')}>Affiliate disclosure</a><a href={u('/data/providers.json')}>Dataset (JSON)</a>
    </nav>
    <p>Facts come from each provider's own pages and carry a source link and a checked date. Providers change their rules often, so confirm with the provider before you sign up. This is not legal, tax or financial advice.</p>
    <p>{hasAffiliate ? 'Some provider links are affiliate links. We may earn a commission if you sign up through them, at no cost to you.' : 'No links on this site are affiliate links today. If that changes, the affected links will be marked.'} <a href={u('/affiliate-disclosure/')}>Read the disclosure</a>.</p>
    <p>&copy; {year} {SITE_NAME}. An independent publisher. Data last checked {CHECKED_ON}.</p>
  </div>
</footer>
</body>
</html>
