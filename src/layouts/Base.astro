---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/public-sans';
import { SITE_NAME, SITE_TAGLINE, CHECKED_ON, u, affiliateProviders, fmtDate } from '../site.js';
interface Crumb { name: string; path: string }
interface Props {
  title: string; description: string; faqs?: { q: string; a: string }[]; jsonLd?: object[];
  dateModified?: string; crumb?: string; crumbs?: Crumb[]; noindex?: boolean;
}
const { title, description, faqs = [], jsonLd = [], dateModified, crumb, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(u('/'), Astro.site).href;
const isHome = canonical === home;
const ogImage = new URL(u('/og.png'), Astro.site).href;
const schemas = [...jsonLd];
const publisher = { '@type': 'Organization', name: SITE_NAME, url: home, logo: new URL(u('/icon-512.png'), Astro.site).href };

// Breadcrumbs: Home > section (if any) > this page.
let middle: Crumb[] = Astro.props.crumbs || [];
if (!Astro.props.crumbs) {
  if (canonical.includes('/provider/')) middle = [{ name: 'Providers', path: '/providers/' }];
  else if (canonical.includes('/country/')) middle = [{ name: 'Countries', path: '/countries/' }];
}
const current = crumb || title.replace(/\s*\(checked [^)]*\)\s*$/, '');
const trail = isHome ? [] : [{ name: 'Home', href: u('/') }, ...middle.map((m) => ({ name: m.name, href: u(m.path) })), { name: current, href: null }];

if (isHome) {
  schemas.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: home, description, publisher });
} else if (!noindex) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.href ? new URL(c.href, Astro.site).href : canonical })),
  });
}
if (dateModified) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    dateModified,
    image: ogImage,
    mainEntityOfPage: canonical,
    author: publisher,
    publisher,
  });
}
if (faqs.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const path = Astro.url.pathname;
const nav = [
  { name: 'Countries', path: '/countries/' },
  { name: 'Providers', path: '/providers/' },
  { name: 'Guides', path: '/guides/' },
  { name: 'How we pick', path: '/methodology/' },
];
const hasAffiliate = affiliateProviders().length > 0;
const year = CHECKED_ON.slice(0, 4);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="theme-color" content="#f7f5ef" />
<link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={u('/favicon-48.png')} type="image/png" sizes="48x48" />
<link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={dateModified ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_NAME}: ${SITE_TAGLINE}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{dateModified && <meta property="article:modified_time" content={dateModified} />}
<link rel="sitemap" href={u('/sitemap-index.xml')} />
{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
<style is:global>
:root {
  --paper:#f7f5ef; --white:#fffefb; --ink:#14201b; --fg:#27322d; --muted:#5d6862; --line:#ddd8ca; --line2:#c9c3b1; --soft:#efece3;
  --accent:#0f5c3f; --accent-ink:#0b4630; --link:#0f5c3f; --gold:#d9a43a;
  --ok-fg:#0f5c3f; --warn-fg:#8a5a00; --no-fg:#a3332a; --unk-fg:#5d6862;
  --radius:4px; --wide:1120px; --narrow:720px;
  --serif:"Source Serif 4 Variable", Georgia, "Times New Roman", serif;
  --sans:"Public Sans Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
}
* { box-sizing:border-box; }
html { -webkit-text-size-adjust:100%; }
body { margin:0; font:17px/1.6 var(--sans); color:var(--fg); background:var(--paper); -webkit-font-smoothing:antialiased; }
a { color:var(--link); text-underline-offset:3px; text-decoration-thickness:1px; }
a:hover { color:var(--ink); text-decoration-thickness:2px; }
img, svg { max-width:100%; }
.skip { position:absolute; left:-999px; }
.skip:focus { left:12px; top:12px; background:#fff; padding:6px 10px; z-index:10; }
.num { font-variant-numeric:tabular-nums; }

.site-header { border-bottom:1px solid var(--ink); background:var(--paper); }
.site-header .in { max-width:var(--wide); margin:0 auto; padding:0 24px; height:62px; display:flex; align-items:center; gap:24px; }
.brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--ink); font-family:var(--serif); font-weight:700; font-size:19px; letter-spacing:-.01em; white-space:nowrap; }
.brand svg { width:30px; height:30px; flex:none; }
.site-nav { margin-left:auto; display:flex; gap:22px; }
.site-nav a { color:var(--fg); text-decoration:none; font-size:15px; font-weight:500; white-space:nowrap; padding:4px 0; border-bottom:2px solid transparent; }
.site-nav a:hover { color:var(--ink); border-bottom-color:var(--line2); }
.site-nav a[aria-current="page"] { color:var(--ink); border-bottom-color:var(--accent); }
@media (max-width:760px) {
  .site-header .in { height:auto; flex-wrap:wrap; gap:0; padding:12px 16px 8px; }
  .site-nav { margin:8px 0 0; width:100%; gap:18px; overflow-x:auto; scrollbar-width:none; }
  .site-nav a { font-size:14.5px; }
}

main { max-width:var(--wide); margin:0 auto; padding:0 24px 24px; }
@media (max-width:760px) { main { padding:0 18px 16px; } }
.prose { max-width:var(--narrow); }
.crumbs { font-size:13.5px; color:var(--muted); margin:22px 0 0; padding:0; list-style:none; display:flex; flex-wrap:wrap; gap:6px; }
.crumbs li:not(:last-child)::after { content:"/"; margin-left:8px; color:var(--line2); }
.crumbs a { color:var(--muted); text-decoration:none; }
.crumbs a:hover { color:var(--ink); text-decoration:underline; }
h1, h2, h3 { color:var(--ink); font-family:var(--serif); font-weight:650; }
h1 { line-height:1.08; font-size:clamp(34px, 5vw, 52px); letter-spacing:-.02em; margin:18px 0 14px; font-weight:700; }
h2[id], h3[id] { scroll-margin-top:24px; }
h2 { margin:52px 0 12px; font-size:clamp(24px, 2.8vw, 30px); letter-spacing:-.01em; line-height:1.2; }
h3 { margin:28px 0 6px; font-size:20px; line-height:1.3; }
.lede { font-size:19px; line-height:1.55; color:var(--fg); max-width:var(--narrow); }
.kicker { font-size:14px; font-weight:600; color:var(--muted); margin:0; }

.byline { font-size:14px; color:var(--muted); margin:4px 0 20px; }
.byline a { color:var(--muted); }

/* Short answer under the H1 on markdown pages */
.summary-box { border-left:3px solid var(--accent); padding:2px 0 2px 18px; margin:20px 0 28px; max-width:var(--narrow); }
.summary-box h2 { margin:0 0 4px; font:600 14px/1.4 var(--sans); color:var(--muted); }
.summary-box ul { margin:0 0 8px; padding-left:20px; }
.summary-box p { margin:0 0 8px; font-size:18px; }

.table-wrap { overflow-x:auto; margin:14px 0; border-top:1px solid var(--ink); }
table { border-collapse:collapse; width:100%; font-size:15.5px; }
main p, main li, main dd { overflow-wrap:anywhere; }
@media (max-width:700px) { .prose table, article > table { display:block; overflow-x:auto; } }
th, td { border-bottom:1px solid var(--line); padding:11px 12px 11px 0; text-align:left; vertical-align:top; }
th { font-size:13.5px; font-weight:600; color:var(--muted); white-space:nowrap; }
tbody th { color:var(--ink); font-size:15.5px; white-space:normal; }
article table { display:block; overflow-x:auto; border-top:1px solid var(--ink); }

/* Status: plain text with a small mark, no pills */
.badge { display:inline-flex; align-items:baseline; gap:7px; font-size:14.5px; font-weight:600; white-space:nowrap; }
.badge::before { content:""; width:8px; height:8px; flex:none; border-radius:50%; background:currentColor; transform:translateY(-1px); }
.ok { color:var(--ok-fg); } .warn { color:var(--warn-fg); } .no { color:var(--no-fg); } .unk { color:var(--unk-fg); }
.badge.no::before, .badge.unk::before { background:none; border:1.5px solid currentColor; }
.note { border-left:3px solid var(--gold); padding:4px 0 4px 16px; margin:24px 0; max-width:var(--narrow); font-size:15.5px; }
.muted, small { color:var(--muted); }

/* Lists of links: ruled rows, not cards */
.cards { list-style:none; padding:0; margin:12px 0; border-top:1px solid var(--line); columns:2 300px; column-gap:40px; }
.cards li { break-inside:avoid; border-bottom:1px solid var(--line); }
.card { display:block; padding:12px 0; text-decoration:none; color:var(--fg); }
.card strong { display:block; font-size:16.5px; color:var(--ink); font-weight:600; }
a.card:hover strong { color:var(--accent); text-decoration:underline; }
.card .sub { display:block; font-size:14.5px; color:var(--muted); margin-top:2px; }
.card .row { display:flex; flex-wrap:wrap; gap:10px; margin-top:6px; align-items:center; }
.inline-list { padding:0; margin:8px 0; list-style:none; display:flex; flex-wrap:wrap; gap:6px 18px; }

.btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; background:var(--accent); color:#fff; border:1px solid var(--accent); border-radius:var(--radius); padding:11px 18px; font:inherit; font-size:16px; font-weight:600; text-decoration:none; cursor:pointer; }
.btn:hover { background:var(--accent-ink); color:#fff; text-decoration:none; }
.btn-ghost { background:transparent; color:var(--ink); border-color:var(--ink); }
.btn-ghost:hover { background:var(--ink); color:var(--paper); }
select, input[type=search] { font:inherit; font-size:16px; padding:11px 12px; border:1px solid var(--ink); border-radius:var(--radius); background:var(--white); color:var(--fg); }
select:focus, input:focus, .btn:focus-visible { outline:3px solid rgba(15,92,63,.3); outline-offset:1px; }
details > summary { cursor:pointer; font-weight:600; color:var(--ink); }

.site-footer { margin-top:80px; border-top:1px solid var(--ink); }
.site-footer .in { max-width:var(--wide); margin:0 auto; padding:28px 24px 40px; font-size:14px; color:var(--muted); display:grid; grid-template-columns:minmax(0,1fr) minmax(0,2fr); gap:12px 48px; }
@media (max-width:760px) { .site-footer .in { grid-template-columns:1fr; padding:24px 18px 32px; } }
.site-footer .fbrand { color:var(--ink); font-family:var(--serif); font-weight:700; font-size:17px; }
.site-footer nav { display:flex; flex-direction:column; gap:4px; }
.site-footer a { color:var(--fg); }
.site-footer .ftext { display:grid; gap:10px; }
.site-footer p { margin:0; }
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="in">
    <a class="brand" href={u('/')} aria-label={`${SITE_NAME} home`}>
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="10" fill="#14201b"/><circle cx="28" cy="30" r="17" fill="none" stroke="#f7f5ef" stroke-width="3.5"/><path d="M28 13c-6.5 5-6.5 29 0 34M28 13c6.5 5 6.5 29 0 34M11 30h34" fill="none" stroke="#f7f5ef" stroke-width="3"/><circle cx="45" cy="45" r="10" fill="#d9a43a" stroke="#14201b" stroke-width="4"/></svg>
      <span>{SITE_NAME}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((n) => <a href={u(n.path)} aria-current={path.startsWith(u(n.path)) ? 'page' : undefined}>{n.name}</a>)}
    </nav>
  </div>
</header>
<main id="main">
  {trail.length > 0 && (
    <nav aria-label="Breadcrumb"><ol class="crumbs">
      {trail.map((c) => <li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
    </ol></nav>
  )}
  <slot />
</main>
<footer class="site-footer">
  <div class="in">
    <div>
      <div class="fbrand">{SITE_NAME}</div>
      <nav aria-label="Footer">
        <a href={u('/countries/')}>Countries</a><a href={u('/providers/')}>Providers</a><a href={u('/guides/')}>Guides</a><a href={u('/methodology/')}>How we pick</a><a href={u('/about/')}>About</a><a href={u('/affiliate-disclosure/')}>Affiliate disclosure</a><a href={u('/data/providers.json')}>Dataset (JSON)</a>
      </nav>
    </div>
    <div class="ftext">
      <p>Every fact on this site comes from the provider's own pages and shows a source link and the date we checked it. Providers change their rules often, so confirm with the provider before you sign up. This is not legal, tax or financial advice.</p>
      <p>{hasAffiliate ? 'Some provider links are affiliate links. We may earn a commission if you sign up through them, at no cost to you.' : 'No links on this site are affiliate links today. If that changes, the affected links will be marked.'} <a href={u('/affiliate-disclosure/')}>Read the disclosure</a>.</p>
      <p>&copy; {year} {SITE_NAME}. Data last checked {fmtDate(CHECKED_ON)}.</p>
    </div>
  </div>
</footer>
</body>
</html>
